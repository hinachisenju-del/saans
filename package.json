{
  "name": "saans",
  "version": "1.0.0",
  "description": "Hyperlocal Air Quality Assistant for Indian Cities: real-time AQI tracking, personalized health advisories, mask guidance, and mass-balance indoor modeling.",
  "private": true,
  "type": "module",
  "license": "MIT",
  "author": "hinachisenju-del",
  "repository": {
    "type": "git",
    "url": "https://github.com/hinachisenju-del/saans.git"
  },
  "keywords": [
    "air-quality",
    "aqi",
    "pm25",
    "health",
    "india",
    "air-pollution",
    "react19",
    "typescript",
    "vite",
    "cloudflare-workers"
  ],
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "preview": "npm run build && wrangler dev",
    "deploy": "npm run build && wrangler deploy"
  },
  "dependencies": {
    "lucide-react": "^1.76.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.70.1",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "autoprefixer": "^10.6.2",
    "happy-dom": "^21.0.4",
    "oxlint": "^1.95.0",
    "postcss": "^8.5.33",
    "tailwindcss": "^3.4.17",
    "typescript": "~7.0.2",
    "vite": "^8.3.6",
    "vitest": "^5.1.1",
    "wrangler": "^4.165.0"
  }
}
